# Copy this file to keystore.properties and keep the real file out of Git.
storeFile=/absolute/path/to/emula-signing.p12
storePassword=replace-with-a-strong-password
keyAlias=emula-upload
keyPassword=replace-with-a-strong-password

# Instead of storing passwords directly, point to protected local files:
# storePasswordFile=/absolute/path/to/store-password.txt
# keyPasswordFile=/absolute/path/to/key-password.txt
