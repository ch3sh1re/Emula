    <string name="raw_mode_dialog_title">Enable raw mode?</string>
    <string name="raw_mode_dialog_message">Standard NFC mode is available on this device. Raw mode is intended for compatibility testing: the app will configure the NFC-A controller parameters directly and verify the UID by reading it back.\n\nThis choice is saved when the app closes and applies to future card changes. An active card will not restart automatically.</string>
    <string name="experimental_raw_dialog_title">Try experimental raw mode?</string>
